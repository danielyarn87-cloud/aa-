# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 GitHub 에 올리지 마세요.

# 사이트 주소 (도메인이 서버 IP 를 가리키고 있어야 HTTPS 인증서가 자동으로 붙습니다)
AA_DOMAIN=analysis.example.com

# 관리 화면 비밀번호 역할. 길고 아무도 모르는 문자열로 (예: openssl rand -hex 24 로 만들기)
AA_ADMIN_TOKEN=

# AI 분석가 (console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=

# 경기 자료 (dashboard.api-football.com 에서 무료 발급, 하루 100회)
API_FOOTBALL_KEY=

# 배당 (the-odds-api.com 에서 무료 발급, 월 500 크레딧)
ODDS_API_KEY=

# 1 이면 worker 가 켜지자마자 한 번 실행
AA_RUN_ON_START=0
